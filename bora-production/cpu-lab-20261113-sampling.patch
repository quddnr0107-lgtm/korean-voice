+/* Isolated CPU single-request experiment; no server/batch/GPU support claim.
+ * Full logits are required: the fused argmax head discards the distribution.
+ * These are the official CustomVoice subtalker sampling parameters. Native RNG
+ * and numerical kernels remain different from PyTorch; no identity claim. */
+extern int qwen_tts_sample(float *, int, float, int, float, float, int *, int);
+static int cpu_lab_cp_enabled(void) {
+    const char *e = getenv("QWEN_CPU_LAB_CP_SAMPLE");
+    return e && !strcmp(e, "1");
+}
+static int cpu_lab_cp_sample(const float *normed, const uint16_t *head, int ch, int vocab) {
+    float logits[QWEN_TTS_CODEBOOK_SIZE];
+    if (!head || vocab != QWEN_TTS_CODEBOOK_SIZE) abort();
+    qwen_matvec_bf16(logits, head, normed, vocab, ch);
+    return qwen_tts_sample(logits, vocab, 0.9f, 50, 1.0f, 1.0f, NULL, 0);
+}
+
 int qwen_cp_predict(qwen_tts_ctx_t *ctx, float *talker_hidden, int code0, int *out_codes) {
+    const int lab_cp = cpu_lab_cp_enabled();
+    if (lab_cp) {
+#if defined(QWEN_HAVE_CUDA) || defined(QWEN_HAVE_METAL)
+        fprintf(stderr, "[cpu-lab] sampled CP requires a CPU-only build\n");
+        abort();
+#endif
+        if (ctx->use_int8 || ctx->use_int4 || ctx->cp_roughness > 0.0f) abort();
+        for (int g = 0; g < 15; g++)
+            if (ctx->cp_lm_head_q4[g] || ctx->cp_lm_head_int8[g]) abort();
+        static __thread int announced = 0;
+        if (!announced) {
+            announced = 1;
+            fprintf(stderr, "[cpu-lab] cp_sampling=1 temperature=0.9 top_k=50 top_p=1 single_cpu_bf16=1\n");
+        }
+    }
     qwen_mm_component(QWEN_COMP_CP);
     qwen_tts_config_t *c = &ctx->config;
     int cp_h = c->cp_hidden_size;
@@ -896,7 +927,9 @@
 
