{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "korean-voice",
  "main": "worker.mjs",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // (옛 경로) Workers AI MeloTTS — /api/tts. 한국어 지원 미확인. 실험실 폴백용으로만 남긴다.
  "ai": {
    "binding": "AI"
  },
  // ── 즉시 합성 서버 = 컨테이너 (server/Dockerfile · Supertonic 3 · CPU) ──
  // Workers Builds 가 main 푸시마다 Dockerfile 을 빌드해 올린다. 요청이 없으면 3분 뒤 잠들어(비용 0) 첫 요청에 다시 뜬다.
  // standard-3 = 2 vCPU · 8 GiB: 문장 하나 합성 약 3~4초(첫 청취자만). 캐시는 R2(korean-voice-tts)에 영구 보관 → 두 번째부터 즉시.
  "containers": [
    {
      "class_name": "TtsContainer",
      "image": "./server/Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TTS_CONTAINER", "class_name": "TtsContainer" },
      // 굽기 대기열 — 전편을 컨테이너가 스스로 굽고 R2 에 넣는다(lib/bake.mjs). POST /bake 는 비밀값 BAKE_TOKEN 이 있어야 한다:
      //   npx wrangler secret put BAKE_TOKEN   (아무 긴 문자열 · yebijun 의 bake-live-tts.mjs 가 같은 값을 보낸다)
      { "name": "BAKE", "class_name": "BakeQueue" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TtsContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["BakeQueue"] }
  ],
  "r2_buckets": [
    { "binding": "TTS_CACHE", "bucket_name": "korean-voice-tts" }
  ],
  "observability": {
    "enabled": true
  }
}
