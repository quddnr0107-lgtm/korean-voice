{
  "schema_version": 1,
  "policy": {
    "network_default": "deny",
    "paid_default": "deny",
    "audio_git_commit": "deny",
    "voice_cloning_without_consent": "deny",
    "goal": "Compare Korean military/legal speech quality under identical inputs while keeping paid usage disabled by default."
